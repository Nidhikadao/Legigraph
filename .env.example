# LegiGraph Environment Configuration

# LLM Provider ('openai', 'gemini', 'ollama', or 'auto')
LLM_PROVIDER=auto

# OpenAI Configuration (Optional - built-in grounded analyst works offline if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Local LLM Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2

# ChromaDB & Embeddings
CHROMA_PERSIST_DIR=./db
COLLECTION_NAME=legislative_bills
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_TOP_K=4

# Text Splitting
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
